# Copiar a .env y ajustar secretos. Nunca commitear .env (R17).
DATABASE_URL=postgresql+asyncpg://turnos:turnos@localhost:5433/turnos
APP_TZ=America/Argentina/Buenos_Aires

# C-13: límites de la exportación de datos del panel
EXPORT_MAX_POR_HORA=20
EXPORT_TIMEOUT_SEGUNDOS=300

# C-15: sesión del panel, IP real detrás de un proxy y límites de solicitudes
SESION_MAXIMA_HORAS=12
TRUSTED_PROXIES=
RATE_LIMIT_TIMEOUT_MS=200
RATE_LIMIT_LOGIN_IP_EMAIL_MAX=5
RATE_LIMIT_LOGIN_IP_EMAIL_VENTANA_SEG=900
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_IP_VENTANA_SEG=900
RATE_LIMIT_LOGIN_EMAIL_MAX=20
